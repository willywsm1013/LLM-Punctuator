# Model to load (HuggingFace name or local path)
MODEL_NAME_OR_PATH=Qwen/Qwen3-1.7B

# Default language for punctuation (zh or en)
DEFAULT_LANGUAGE=zh

# Default chunk size for splitting long text
DEFAULT_CHUNK_SIZE=200

# Server host and port
HOST=0.0.0.0
PORT=8000

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info
